# RAKSHA Backend Environment Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raksha

# External Provider Credentials (Optional - Graceful Fallback Included)
USGS_GEOJSON_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson
NASA_FIRMS_MAP_KEY=
COPERNICUS_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Routing & Storage
ROUTING_SERVICE_URL=http://localhost:8002
OBJECT_STORAGE_BUCKET=raksha-imagery
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
