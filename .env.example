# RAKSHA Production & Development Environment Configuration

# Server Environment
PORT=4000
NODE_ENV=production

# Database Configuration (PostgreSQL + PostGIS)
# On Render / Production: Optional. If omitted or unreachable, RAKSHA runs in
# its resilient local state store mode (data_store.json) with zero startup delay.
# When provided, PostgreSQL tables and spatial queries are automatically initialized.
# Example: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=

# Frontend API URL (Optional override)
# In unified production deployment, the frontend automatically uses relative '/api'
# and '/api/events/stream' on the same domain. Leave blank for unified Render deployment.
# Only specify if running frontend and backend on distinct domains.
# VITE_API_URL=https://your-backend.onrender.com/api

# External Observation Providers (All Optional - Graceful Fallbacks Included)
USGS_GEOJSON_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson
NASA_FIRMS_MAP_KEY=
COPERNICUS_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Routing & Storage (Optional - In-Memory Algorithms Included)
ROUTING_SERVICE_URL=http://localhost:8002
OBJECT_STORAGE_BUCKET=raksha-imagery
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
